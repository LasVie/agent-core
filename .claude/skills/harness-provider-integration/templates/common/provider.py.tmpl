"""Provider factory for the __DISPLAY__ harness.

openjiuwen discovers this class through the ``openjiuwen.harness_providers``
entry point declared in ``pyproject.toml``; ``create_harness(manifest,
provider="__PROVIDER__")`` then builds harnesses from it.
"""

from __future__ import annotations

from dataclasses import fields
from typing import Any

from openjiuwen.harness_protocol import HarnessCard, JsonObject, ModelChoice
from __PKG__.config import __CLASS__HarnessConfig
from __PKG__.harness import __CLASS__Harness


class __CLASS__HarnessProvider:
    """Validate provider configuration and create an unstarted __DISPLAY__ harness."""

    @property
    def card(self) -> HarnessCard:
        return __CLASS__Harness.card

    @staticmethod
    def create(config: JsonObject) -> __CLASS__Harness:
        return __CLASS__Harness(__CLASS__HarnessConfig.from_mapping(config))

    @staticmethod
    def model_config(choice: ModelChoice, *, fallback: ModelChoice | None = None) -> dict[str, Any]:
        """Map a host's model choice onto this provider's configuration fields.

        openjiuwen calls this for a manifest model and for a team member's
        model (a built-in one the leader picked, or one from the team's model
        pool when the card declares ``ENDPOINT_MODELS``); configuration the
        host passes explicitly still wins. A field the config does not declare
        is an error, never silently dropped.

        Raises:
            ValueError: When the choice needs a field this config lacks (an
                endpoint, an effort) or a fallback, which this provider has not.
        """
        if fallback is not None:
            raise ValueError("__DISPLAY__ has no fallback model")
        endpoint = choice.endpoint
        values = {
            "model": choice.model,
            "effort": choice.effort,
            "provider": endpoint.provider if endpoint is not None else None,
            "api_base": endpoint.api_base if endpoint is not None else None,
            "api_key": endpoint.api_key if endpoint is not None else None,
        }
        accepted = {item.name for item in fields(__CLASS__HarnessConfig)}
        # The endpoint's protocol label only matters to configs that take it.
        values = {key: value for key, value in values.items() if value is not None}
        if "provider" not in accepted:
            values.pop("provider", None)
        unsupported = sorted(set(values) - accepted)
        if unsupported:
            raise ValueError(f"__DISPLAY__ cannot set {', '.join(unsupported)}")
        return values


__all__ = ["__CLASS__HarnessProvider"]
